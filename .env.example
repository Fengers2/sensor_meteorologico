# MySQL local: completa usuario y contraseña de tu servidor
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=Engers_meteorologico
DB_USER=
DB_PASSWORD=

# Opcional: informar solo si los nombres no se detectan automáticamente
# DB_TEMPERATURE_COLUMN=temperatura
# DB_HUMIDITY_COLUMN=humedad
# DB_TIMESTAMP_COLUMN=fecha_hora

# Linux examples: /dev/ttyUSB0 or /dev/ttyACM0
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=9600
SERIAL_TIMEOUT=1
SERIAL_RECONNECT_SECONDS=3

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
HISTORY_LIMIT=500
