# MySQL local (Docker Compose defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=environment_monitor
DB_USER=monitor
DB_PASSWORD=change-me

# Linux examples: /dev/ttyUSB0 or /dev/ttyACM0
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=9600
SERIAL_TIMEOUT=1
SERIAL_RECONNECT_SECONDS=3

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
HISTORY_LIMIT=500
